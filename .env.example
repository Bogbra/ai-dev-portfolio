# =============================================================================
# Root .env.example — dokumentiert alle benötigten Umgebungsvariablen.
# Kopiere diese Datei zu .env und trage echte Werte ein.
# Echte .env-Dateien sind gitignored — nur .env.example wird versioniert.
# =============================================================================

# --- apps/api (Fastify — contact form only) ---
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# Mailer (Resend — https://resend.com) — leave empty for local dev; the
# contact form just returns a clear "delivery disabled" message instead
# of a real send when ENABLE_EMAIL_SENDING=false (the default) or no key
# is set.
RESEND_API_KEY=
MAIL_FROM=portfolio@example.com
MAIL_TO=your@email.com

# Email sending — keep false on public demo
ENABLE_EMAIL_SENDING=false

# --- apps/ai (Python FastAPI — all AI workflows) ---
# PORT=4000 (set in apps/ai/.env)
# ALLOWED_ORIGINS=http://localhost:3000

# MCP server (mounted at /mcp) — bare hostnames, no scheme, port included
# for local dev. The MCP SDK rejects any request whose Host header isn't in
# this list (DNS-rebinding protection) — add the deployed hostname (e.g.
# your Railway domain) here in production or every real MCP client 421s.
MCP_ALLOWED_HOSTS=localhost:4000,127.0.0.1:4000

# MCP live-demo quota for the create_researched_post tool (separate from the
# general /mcp rate limit above). After MCP_LIVE_CALL_LIMIT real workflow
# runs per client IP within the window, the tool falls back to the
# deterministic mock and reports that in its response.
MCP_LIVE_DEMO_ENABLED=true
MCP_LIVE_CALL_LIMIT=3
MCP_LIVE_QUOTA_WINDOW_SECONDS=86400

# AI provider (all AI workflows) — leave OPENAI_API_KEY empty to run every
# workflow in mock mode (no cost, deterministic, no external calls). A
# plain `cp .env.example .env` with no edits must still boot in a fully
# working mock-mode demo, not silently attempt (and fail) live calls with
# a placeholder value.
OPENAI_API_KEY=
OPENAI_BASE_URL=               # optional — leave empty to use api.openai.com
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI client timeouts and retries (all workflows)
OPENAI_TIMEOUT_SECONDS=30
OPENAI_VOICE_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1

# Tavily web search (CS01 topic enrichment, CS02 research — optional,
# leave empty to skip web-context enrichment)
TAVILY_API_KEY=

# CS01 — AI Operations Workflow Agent
MAX_UPLOAD_SIZE_BYTES=1048576
MAX_UPLOAD_ROWS=100
MAX_REQUEST_LENGTH=500

# CS02 — Multi-Agent LinkedIn Post
MAX_TOPIC_LENGTH=300

# CS03 — RAG Research Assistant
MAX_UPLOAD_MB=10
MAX_TOTAL_UPLOAD_MB=25
MAX_PDFS=3
MAX_CHUNKS=500
MAX_QUESTIONS_PER_HOUR=20

# Voice Agent Lab
# VOICE_OPENAI_API_KEY: real OpenAI key for Whisper STT and TTS-1.
# Required when OPENAI_API_KEY points to a proxy that lacks audio endpoints.
# Falls back to OPENAI_API_KEY if not set (only works if the key hits api.openai.com directly).
# Leave empty — the Voice Agent Lab has no mock mode and shows a disabled
# state until a usable key is configured.
# VOICE_TTS_VOICE options: alloy, echo, fable, onyx, nova, shimmer
VOICE_OPENAI_API_KEY=
VOICE_TTS_VOICE=alloy
VOICE_MAX_REQUESTS_PER_HOUR=20
VOICE_MAX_REQUESTS_PER_DAY=50

# SEO Strategy Lab — rate limits (requests per IP)
SEO_MAX_REQUESTS_PER_HOUR=10
SEO_MAX_REQUESTS_PER_DAY=30

# --- apps/web ---
# URL of the Fastify contact backend (public — visible in browser)
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL of the Python AI backend (public — visible in browser)
NEXT_PUBLIC_AI_URL=http://localhost:4000
# Public site URL — used for canonical and OG metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
