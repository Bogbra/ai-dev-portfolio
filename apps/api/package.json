{
  "name": "@ai/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai/types": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "resend": "^4.5.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@ai/config": "workspace:*",
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.1.9"
  }
