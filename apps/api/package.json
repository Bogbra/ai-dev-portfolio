    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "resend": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai/config": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
