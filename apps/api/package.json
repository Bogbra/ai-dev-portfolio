{
  "name": "@ai/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx/esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai/types": "workspace:*",
