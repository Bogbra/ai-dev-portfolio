# apps/api — Fastify Contact Service
# Kopiere zu .env und trage echte Werte ein. Nie in Git committen.

NODE_ENV=development
PORT=3001

# CORS: kommaseparierte Liste erlaubter Origins (kein Leerzeichen)
ALLOWED_ORIGINS=http://localhost:3000

# Mailer (Resend — https://resend.com) — leave empty for local dev; the
# contact form just returns a clear "delivery disabled" message instead of
# a real send when ENABLE_EMAIL_SENDING=false (the default) or no key is set.
RESEND_API_KEY=
MAIL_FROM=portfolio@example.com
MAIL_TO=your@email.com

# Email sending — MUST remain false on the public demo to prevent abuse
ENABLE_EMAIL_SENDING=false
