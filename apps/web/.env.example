# apps/web — Umgebungsvariablen
# Kopiere zu .env.local und trage echte Werte ein. Nie in Git committen.
# Nur NEXT_PUBLIC_*-Variablen sind im Browser sichtbar.

# URL des Fastify-Kontaktformular-Backends
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL des Python AI-Backends
NEXT_PUBLIC_AI_URL=http://localhost:4000

# Public site URL — used for canonical and OG metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
